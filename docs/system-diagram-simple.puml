@startuml system-diagram-simple
title Docling Studio — System Architecture (simplified)

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 50
skinparam ranksep 60
skinparam rectangle {
  BorderColor #666666
}
skinparam cloud {
  BackgroundColor #333333
  FontColor #FFFFFF
  BorderColor #111111
}
skinparam database {
  BorderColor #666666
}
skinparam ArrowColor #444444

actor "User" as User

rectangle "Web UI\nExtract · Ask · Graph" as UI
rectangle "FastAPI\napp.py · :8000" as API
rectangle "Converter\nDocling · OCR · CV · VLM" as CONV
rectangle "RAG engine\nchunk · hybrid search · answer" as RAG
rectangle "Graph engine\nregex extract · BFS · 2-hop" as KG

database "Markdown corpus\npkg/markdown · knowledge_base" as FILES
database "PostgreSQL\npgvector · full-text" as PG
database "knowledge_graph.json" as KGJSON

rectangle "Ollama\nbge-m3 · local · 1024-d" as OLLAMA

cloud "Anthropic Claude\nclaude-opus-5" as CLAUDE

User -down-> UI : HTTPS
UI -down-> API : REST · SSE
API -right-> CONV : convert(src)
CONV -down-> FILES : output.md

API -down-> RAG : embed · ask
API -down-> KG : query_graph()

RAG -down-> FILES : read .md
RAG -down-> OLLAMA : embed (local)
RAG -down-> PG : store · search
RAG -down-> CLAUDE : excerpts → answer

KG -down-> FILES : read .md · regex
KG -down-> KGJSON : cache

note bottom of FILES
  Both engines read the SAME Markdown corpus
  and never call each other.
end note

note bottom of CLAUDE
  Omitted here: preview rendering, the individual
  image readers (Tesseract · table_cv · flow_cv ·
  Qwen3-VL), md_chunker, and the optional cloud
  vision provider. Full view: system-diagram.png
end note

@enduml
