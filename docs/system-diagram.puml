@startuml system-diagram
title Docling Studio — System Architecture

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 50
skinparam ranksep 60
skinparam rectangle {
  BorderColor #666666
}
skinparam cloud {
  BackgroundColor #333333
  FontColor #FFFFFF
  BorderColor #111111
}
skinparam package {
  BorderColor #888888
  FontStyle bold
}
skinparam ArrowColor #444444

actor "User / Browser" as User

package "Web UI (React SPA)" {
  rectangle "Extract page\nupload · convert · embed" as Extract
  rectangle "Ask page\nquestion · streamed answer" as Ask
}

package "FastAPI app.py · :8000" {
  rectangle "API routes\n/api/upload · convert · embed · ask" as API
  rectangle "preview.py\nLibreOffice + pdftoppm" as Preview
  rectangle "converter.py\nDocling → Markdown" as Converter
  rectangle "Image readers\nTesseract · table_cv · flow_cv" as Readers
  rectangle "Qwen3-VL (local)\nMLX, optional" as Qwen
  rectangle "rag.py\nindex · hybrid search · answer" as RAG
  rectangle "md_chunker.py\nheading-aware chunks" as Chunker
}

database "Workdir + knowledge_base/\nsource · output.md" as Files
database "PostgreSQL + pgvector\nrag_documents · rag_chunks\nHNSW cosine · GIN tsvector" as PG

cloud "GPT / Claude vision\noptional, via Docling VLM" as VLM
cloud "Cohere Embed\nembed-v4.0 · 1536-d" as Cohere
cloud "Anthropic Claude\nclaude-opus-5" as Claude

User -down-> Extract : HTTPS
User -down-> Ask : HTTPS
Extract -down-> API : REST/JSON
Ask -down-> API : POST /api/ask
API .up.> Ask : SSE stream

API -down-> Preview : render
API -down-> Converter : convert
Converter -down-> Readers : pictures
Readers -down-> Qwen : dense images
Readers -down-> VLM : HTTPS, API key
API -down-> Files : write .md

API -down-> RAG : embed / ask
RAG -down-> Files : read .md
RAG -down-> Chunker : chunk
RAG -down-> Cohere : HTTPS, API key
RAG -down-> PG : SQL (psycopg)
RAG -down-> Claude : HTTPS stream

note bottom of Claude
  Dark boxes = external systems
  this app depends on but does
  not control.
end note

@enduml
