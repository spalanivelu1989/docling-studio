@startuml kg-neo4j-schema
title Solvay SPARK knowledge graph — Neo4j schema (meta-graph)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #475569
skinparam ArrowFontColor #0F172A
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.4
skinparam usecase {
  FontColor #0F172A
  FontSize 13
  BorderThickness 2
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #334155
  FontSize 10
}

usecase ":Stream\ncount: 4" as STREAM #EDE9FE;line:8B5CF6
note top of STREAM
code: string
description: string
end note
usecase ":Spec\ncount: 47" as SPEC #FFEDD5;line:F97316
note left of SPEC
is_primary: boolean
ticket: string
end note
usecase ":Document\ncount: 83" as DOCUMENT #F1F5F9;line:64748B
note top of DOCUMENT
chars: integer
filename: string
format: string
source: string
end note
usecase ":System\ncount: 18" as SYSTEM #E0F2FE;line:0284C7
note right of SYSTEM
code: string
description: string
end note
usecase ":Process\ncount: 202" as PROCESS #DCFCE7;line:10B981
note bottom of PROCESS
code: string
description: string
in_bpml: boolean
jira_key: string
end note

DOCUMENT -up-> STREAM : ":BELONGS_TO · 70"
DOCUMENT -left-> SPEC : ":REFERENCES_TICKET · 41"
DOCUMENT -left-> SPEC : ":IMPLEMENTS_TICKET · 13"
DOCUMENT -right-> SYSTEM : ":INTERACTS_WITH · 70"
DOCUMENT -right-> SYSTEM : ":RUNS_ON · 40"
DOCUMENT -right-> SYSTEM : ":USES_UI · 28"
DOCUMENT -right-> SYSTEM : ":INTERFACES_WITH · 21"
DOCUMENT -right-> SYSTEM : ":INTEGRATES_WITH · 12"
DOCUMENT -right-> SYSTEM : ":CONNECTS_TO · 10"
PROCESS --> PROCESS : ":SUBPROCESS_OF · 185"
DOCUMENT -down-> PROCESS : ":SPECIFIES_PROCESS · 70"
@enduml
